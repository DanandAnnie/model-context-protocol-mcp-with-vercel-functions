# Dan Cloud Computers - environment configuration
# Copy to .env (compose) or `export` these before running the API.

# Shared internal API token (used by the dashboard, MCP server, and tests).
DCC_API_TOKEN=dev-secret-token

# Desktop image name spawned for each computer.
DCC_IMAGE=dan-cloud-computer/desktop:latest

# First host port handed out for noVNC; subsequent computers get +1, +2, ...
DCC_BASE_PORT=6080

# Where the registry + per-computer volumes live (as seen by the API process).
DCC_DATA_DIR=./data

# Host path of DCC_DATA_DIR. Only needed when the API runs INSIDE a container
# and spawns sibling desktop containers (bind mounts need host paths).
# DCC_HOST_DATA_DIR=/absolute/path/to/dan-cloud-computer/data

# Used by mcp/server.py to reach the control API.
DCC_API_URL=http://localhost:8000
