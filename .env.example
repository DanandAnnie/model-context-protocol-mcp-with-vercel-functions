# PropertyRadar MCP Server - Environment Variables
# Copy this to .env and fill in your API keys

# ── Required ──────────────────────────────────────────────────
# PropertyRadar API Token (get from https://app.propertyradar.com/settings/api)
PROPERTY_RADAR_API_TOKEN=

# ── Optional (enhance data coverage) ─────────────────────────
# RapidAPI Key for Zillow Zestimate data (get from https://rapidapi.com)
RAPIDAPI_KEY=

# ATTOM Data API Key (get from https://api.gateway.attomdata.com)
ATTOM_API_KEY=

# US Census Bureau API Key (get from https://api.census.gov/data/key_signup.html)
# Works without a key at lower rate limits
CENSUS_API_KEY=

# HUD User API Key for Fair Market Rent data (get from https://www.huduser.gov/hudapi/public/register)
HUD_API_KEY=

# ── Mission Control dashboard ────────────────────────────────
# Shared secret for the /mission-control dashboard. When set, the dashboard
# requires a login and /api/invoke rejects unauthenticated requests (401).
# Pick a long random string (e.g. `openssl rand -hex 32`). Leave blank to
# keep the dashboard fully open (NOT recommended for production).
MISSION_CONTROL_TOKEN=

# ── GHL Pilot — Red Rock Real Estate sub-account ────────────────────────
# Private Integration token from GHL Settings → Integrations → Private Integrations
# (read-only by default; speed-to-lead writes only run when execute=true)
GHL_API_KEY=
# Sub-account location ID (Settings → Company → Locations)
GHL_LOCATION_ID=
GHL_BASE_URL=https://services.leadconnectorhq.com

# ── Speed-to-Lead engine ────────────────────────────────────────────────
# Shared secret for the public /api/lead webhook. External sources (Zillow,
# portals, ad platforms) authenticate by sending it as the `x-webhook-secret`
# header or `?key=` query param. Generate with `openssl rand -hex 32`.
LEAD_WEBHOOK_SECRET=
# Set to "on" to perform GHL writes (contact, opportunity, tags, call tasks)
# by default on every /api/lead request. Default off = dry-run plan only.
LEAD_AUTOEXECUTE=
# Set to "on" to actually SEND the immediate first response (SMS/email via
# GHL). Default off = the first response is drafted but not sent.
LEAD_AUTORESPONDER=
# IANA timezone used to clamp SMS/call touches to business hours (8am-9pm).
LEAD_TIMEZONE=America/Denver
# Optional: map logical pipeline names to real GHL pipeline/stage IDs, e.g.
# {"Buyer Pipeline":{"pipelineId":"abc","stageId":"def"}}
GHL_PIPELINE_MAP=

# ── Agent identity (used to personalize follow-up templates) ─────────────
AGENT_NAME=
AGENT_PHONE=
AGENT_CALENDAR_URL=

# ── Operator alerts (Telegram) ──────────────────────────────────────────
# Instant new-lead alerts are sent here. Shared with the neighbor-farm webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
