# ---- Avatar Studio configuration ----------------------------------------
# Every key is optional. With nothing set the app runs in DEMO mode:
# stock avatars, browser text-to-speech previews, and simulated renders.

# Which backend renders talking-avatar videos: "heygen" | "did" | "mock"
AVATAR_PROVIDER=mock
# Which backend produces speech / lists voices: "elevenlabs" | "heygen" | "mock"
# HeyGen rendering always uses HeyGen voices (its API accepts no others); D-ID uses
# ElevenLabs when configured, otherwise its built-in Microsoft voices.
TTS_PROVIDER=mock
# Which backend writes scripts: "anthropic" | "mock"
SCRIPT_PROVIDER=mock

# HeyGen API (https://app.heygen.com/settings?nav=API)
HEYGEN_API_KEY=

# Live video for the interactive avatar uses HeyGen Streaming automatically when
# AVATAR_PROVIDER=heygen and HEYGEN_API_KEY are set. Set to false to keep the portrait only.
STREAMING_AVATAR=true

# D-ID API (https://studio.d-id.com/account-settings)
DID_API_KEY=

# ElevenLabs API (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Anthropic API key for the AI script writer
ANTHROPIC_API_KEY=

# Plans and billing. RENDER_LIMIT_PER_MONTH caps the Free plan; PLAN_PRO_RENDERS caps Pro
# (unset = unlimited). BILLING_PROVIDER "stripe" needs the Stripe keys and a recurring Price id;
# point a Stripe webhook at /api/webhooks/stripe for checkout.session.completed and
# customer.subscription.updated/deleted. With "mock" (default) upgrades apply instantly, no payment.
PLAN_PRO_RENDERS=
PLAN_PRO_PRICE_LABEL=$29 / month
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Workspace invite emails: "resend" | "mock". With "mock" (the default) invites are
# link-only and the app shows the link to copy. Resend: https://resend.com/api-keys
EMAIL_PROVIDER=mock
RESEND_API_KEY=
# Sender address; must be on a domain verified in Resend (the resend.dev sender works for testing).
EMAIL_FROM=Avatar Studio <onboarding@resend.dev>

# Persistence. Leave blank to use an in-memory store (fine for local dev,
# resets on every cold start on serverless hosts). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Access control, in order of precedence:
# 1. Per-user accounts (Supabase Auth). Users sign up / sign in with email + password and
#    only see their own videos, avatars, and translations. Enable email auth in the
#    Supabase dashboard and set the site URL to this deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 2. One shared password (used when the Supabase public keys above are not set).
STUDIO_PASSWORD=
# 3. Neither set: open access (local development only).

# Optional. Maximum renders per account per calendar month (UTC). Unset = unlimited.
# Failed starts do not count. Exceeding it returns HTTP 429 from POST /api/videos.
RENDER_LIMIT_PER_MONTH=

# Public URL of this deployment, used to build provider webhook callback URLs.
APP_URL=http://localhost:3000
# Shared secret for provider webhook callbacks. Callbacks are only registered and
# accepted when this is set; without it the app relies on polling.
WEBHOOK_SECRET=
