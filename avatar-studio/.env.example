# ---- Avatar Studio configuration ----------------------------------------
# Every key is optional. With nothing set the app runs in DEMO mode:
# stock avatars, browser text-to-speech previews, and simulated renders.

# Which backend renders talking-avatar videos: "heygen" | "did" | "mock"
AVATAR_PROVIDER=mock
# Which backend produces speech / lists voices: "elevenlabs" | "heygen" | "mock"
# HeyGen rendering always uses HeyGen voices (its API accepts no others); D-ID uses
# ElevenLabs when configured, otherwise its built-in Microsoft voices.
TTS_PROVIDER=mock
# Which backend writes scripts: "anthropic" | "mock"
SCRIPT_PROVIDER=mock

# HeyGen API (https://app.heygen.com/settings?nav=API)
HEYGEN_API_KEY=

# D-ID API (https://studio.d-id.com/account-settings)
DID_API_KEY=

# ElevenLabs API (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Anthropic API key for the AI script writer
ANTHROPIC_API_KEY=

# Persistence. Leave blank to use an in-memory store (fine for local dev,
# resets on every cold start on serverless hosts). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, the studio (everything except /, /login and /share/*) requires this password.
STUDIO_PASSWORD=

# Public URL of this deployment, used to build provider webhook callback URLs.
APP_URL=http://localhost:3000
# Shared secret for provider webhook callbacks. Callbacks are only registered and
# accepted when this is set; without it the app relies on polling.
WEBHOOK_SECRET=
